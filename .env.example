
# ImgBB image storage
IMGBB_KEY=your_imgbb_key

# Cloudinary video storage
CLOUDINARY_VIDEO_CLOUD_NAME=your_video_cloud_name
CLOUDINARY_VIDEO_PRESET=your_video_unsigned_preset

# Cloudinary file storage
CLOUDINARY_FILE_CLOUD_NAME=your_file_cloud_name
CLOUDINARY_FILE_PRESET=your_file_unsigned_preset

# Persistent custom URL mapping
UPSTASH_REDIS_REST_URL=your_upstash_rest_url
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# Public API domain
PUBLIC_BASE_URL=https://durbar-plus2.vercel.app
